---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import Faq from '../../components/Faq.astro';
import House from '../../components/House.astro';
import LinkRows from '../../components/LinkRows.astro';
import PageHero from '../../components/PageHero.astro';
import Proof from '../../components/Proof.astro';
import Sources from '../../components/Sources.astro';
import ZoneList from '../../components/ZoneList.astro';
import { SERVICES } from '../../data/site';
import { fr } from '../../lib/typo';
import { service as serviceSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/services/${entry.id}`;
const tier = SERVICES.find((s) => s.slug === entry.id)?.tier;

const all = await getCollection('services');
const guides = await getCollection('guides');
const relatedServices = d.related.map((s) => all.find((x) => x.id === s)).filter((x) => x !== undefined);
const relatedGuides = d.guides.map((s) => guides.find((x) => x.id === s)).filter((x) => x !== undefined);

const crumbs = [
  { name: 'Accueil', href: '/' },
  { name: 'Services', href: '/services' },
  { name: d.label, href: path },
];
---
<Base title={d.title} description={d.description} crumbs={crumbs} modified={d.updated} schema={[serviceSchema(path, d.label, d.description, d.names)]}>
  <PageHero crumbs={crumbs} kicker={`${tier === 2 ? 'En complément' : 'Spécialité'} · Charente (16)`} h1={d.h1} answer={d.answer} contactHref={`/contact?projet=${encodeURIComponent(d.label)}`}>
    <House slot="visual" active={entry.id} markers={false} />
  </PageHero>

  <section class="s-paper section" data-section="problemes">
    <div class="wrap">
      <p class="label">Votre problème</p>
      <h2 class="h1 pb__title">Ce qui vous amène, et ce que j'y fais.</h2>
      <ul class="pb">
        {d.problems.map((p, i) => (
          <li data-reveal style={`--d:${(i % 3) * 0.06}s`}>
            <h3>{fr(p.problem)}</h3>
            <p>{fr(p.solution)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="includes s-yellow" data-section="exemples">
    <div class="wrap">
      <h2 class="label">Exemples de travaux</h2>
      <ul>
        {d.includes.map((item, i) => (
          <li data-reveal style={`--d:${(i % 4) * 0.05}s`}><span class="diamond" aria-hidden="true"></span>{fr(item)}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="s-white section">
    <div class="wrap body">
      <article class="prose"><Content /></article>
      <aside class="side">
        {d.limits.length > 0 && (
          <div>
            <h2 class="label">À savoir avant de m'appeler</h2>
            <ul class="side__list side__limits">
              {d.limits.map((item) => <li>{fr(item)}</li>)}
            </ul>
          </div>
        )}
        {relatedGuides.length > 0 && (
          <div>
            <h2 class="label">Guides pour préparer vos travaux</h2>
            <ul class="side__list">
              {relatedGuides.map((g) => <li><a href={`/guides/${g.id}`}>{fr(g.data.h1)}</a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <Proof line={d.proof} service={entry.id} />

  <ZoneList />

  {d.faq.length > 0 && (
    <section class="s-white section">
      <div class="wrap narrow"><Faq items={d.faq} title={`${d.label} : vos questions`} /></div>
    </section>
  )}

  {relatedServices.length > 0 && (
    <section class="s-paper section">
      <div class="wrap">
        <h2 class="related__title">Souvent réalisé avec</h2>
        <LinkRows items={relatedServices.map((s) => ({ href: `/services/${s.id}`, title: s.data.label, text: s.data.description }))} />
      </div>
    </section>
  )}

  {d.sources.length > 0 && (
    <section class="s-white src">
      <div class="wrap narrow"><Sources items={d.sources} /></div>
    </section>
  )}

  <Cta title={`${d.label} : parlons de votre projet.`} service={d.label} />
</Base>

<style>
  .pb__title { max-width: 18ch; margin-block: 1rem clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .pb { display: grid; gap: 1.75rem 2.5rem; }
  .pb li { display: grid; gap: 0.6rem; align-content: start; padding-top: 0.9rem; border-top: 2px solid var(--anthracite); }
  .pb h3 { font-size: var(--fs-l); }
  .pb p { color: var(--muted); }
  @media (min-width: 48rem) { .pb { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .pb { grid-template-columns: repeat(3, 1fr); } }
  .includes { padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .includes ul { display: grid; gap: 0.75rem 2.5rem; margin-top: 1.1rem; }
  .includes li { display: flex; gap: 0.8rem; align-items: baseline; font-weight: 600; font-size: var(--fs-l); line-height: 1.25; }
  .includes .diamond { --accent: var(--anthracite); }
  @media (min-width: 48rem) { .includes ul { grid-template-columns: repeat(2, 1fr); } }
  .body { display: grid; gap: 3rem; }
  .side { display: grid; gap: 2.25rem; align-content: start; }
  .side__list { margin-top: 0.7rem; display: grid; gap: 0.6rem; border-top: 2px solid var(--anthracite); padding-top: 0.8rem; font-weight: 600; }
  .side__limits { font-weight: 500; }
  @media (min-width: 60rem) {
    .body { grid-template-columns: minmax(0, 1fr) 21rem; gap: clamp(3rem, 6vw, 7rem); }
    .side { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
  .narrow { max-width: 64rem; }
  .related__title { margin-bottom: 1.5rem; }
  .src { padding-block: 0 var(--section); }
</style>
