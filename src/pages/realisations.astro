---
// Toutes les réalisations, chantier par chantier : photos, maquette 3D, et le premier chantier
// raconté au défilement. Le contenu vient de src/data/preuves.ts et src/data/maquettes.ts ;
// la mise en scène est dans src/scripts/realisations.ts.
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cote from '../components/Cote.astro';
import Cta from '../components/Cta.astro';
import Galerie from '../components/Galerie.astro';
import Maquette from '../components/Maquette.astro';
import { MAQUETTES } from '../data/maquettes';
import { SERVICES, SITE } from '../data/site';
import { CHANTIERS, TOTAL_PHOTOS } from '../lib/realisations';
import { fr } from '../lib/typo';

type Chantier = (typeof CHANTIERS)[number];

const crumbs = [{ name: 'Accueil', href: '/' }, { name: 'Réalisations', href: '/realisations' }];
const metier = (slug: string) => SERVICES.find((s) => s.slug === slug);
const deux = (n: number) => String(n).padStart(2, '0');

// Les étapes d'un chantier sont numérotées dans l'ordre où elles apparaissent.
const etiquettes = (chantier: Chantier) => {
  const ordre = [...new Set(chantier.cliches.map((c) => c.etape).filter((e) => e !== undefined))];
  return chantier.cliches.map((c) => (c.etape ? `Étape ${ordre.indexOf(c.etape) + 1} · ${c.etape}` : undefined));
};
const lieu = (c: Chantier) => [c.commune, c.annee].filter(Boolean).join(', ');
const nombre = (c: Chantier) => `${c.cliches.length} photo${c.cliches.length > 1 ? 's' : ''}`;

// Le chantier raconté au défilement : celui qui porte un « recit ».
const vedette = CHANTIERS.find((c) => c.recit?.length);
const etapes = (vedette?.recit ?? []).flatMap((e) => {
  const cliche = vedette?.cliches.find((c) => c.fichier === e.fichier);
  return cliche ? [{ ...e, cliche }] : [];
});
const couches = vedette ? (MAQUETTES[vedette.slug]?.().couches ?? []) : [];

const index = await Promise.all(CHANTIERS.map(async (c) => ({
  c,
  apercu: (await getImage({ src: c.une.image, width: 520, format: 'webp', quality: 72 })).src,
})));

// Les quatre photos de l'en-tête, de la plus proche à la plus lointaine.
const planche = ['piece-d-eau-plaques-hydrofuges', 'doublage-maison-en-pierre', 'cuisine-avec-ilot', 'couverture-maison-neuve']
  .map((slug) => CHANTIERS.find((c) => c.slug === slug)?.une)
  .filter((c) => c !== undefined);
const profondeurs = [0.45, 0.9, 0.65, 0.2];
---
<Base
  title="Réalisations et photos de chantiers | BR 16 BATIMENT"
  description="Les chantiers de BR 16 BATIMENT en photos et en maquettes 3D : doublage isolé, plafond en placo, pièce d'eau, menuiseries, pose de cuisine et couverture."
  crumbs={crumbs}
>
  <section class="rh s-dark">
    <div class="rh__grille" aria-hidden="true"></div>
    <div class="wrap rh__inner">
      <div class="rh__texte">
        <nav aria-label="Fil d'Ariane">
          <ol class="crumbs label">
            {crumbs.map((c, i) => (
              <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
            ))}
          </ol>
        </nav>
        <p class="label label--accent">{CHANTIERS.length} chantiers · {TOTAL_PHOTOS} photos · {CHANTIERS.filter((c) => MAQUETTES[c.slug]).length} maquettes 3D</p>
        <h1 class="rh__titre">
          <span class="line" style="--i:0"><span>Mes chantiers,</span></span>
          <span class="line" style="--i:1"><span>couche</span></span>
          <span class="line" style="--i:2"><span class="accent">par couche.</span></span>
        </h1>
        <p class="rh__lede ph__answer">{fr('Ces photos viennent des chantiers de BR 16 BATIMENT. La plupart sont prises pendant les travaux, quand on voit encore l\'ossature, l\'isolant et les plaques. Chaque chantier a aussi sa maquette : faites-la tourner, éclatez-la, et regardez comment c\'est fait derrière un mur fini.')}</p>
        <div class="btn-row">
          <a class="btn" href="/contact">Demander un devis <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={SITE.phoneHref}>{SITE.phone}</a>
        </div>
      </div>
      <div class="rh__planche" aria-hidden="true">
        {planche.map((c, i) => (
          <span class={`rh__photo rh__photo--${i}`} data-profondeur={profondeurs[i]}>
            <Picture src={c.image} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(min-width: 60rem) 24vw, 50vw" alt="" loading="eager" />
          </span>
        ))}
      </div>
    </div>
    <p class="wrap label rh__suite" aria-hidden="true"><span class="rh__fleche">↓</span> Faites défiler : un mur se monte</p>
  </section>

  {vedette && etapes.length > 0 && (
    <section class="recit s-ink" data-maquette={vedette.slug}>
      <div class="recit__pin">
        <div class="wrap recit__grid">
          <div class="recit__texte">
            <div class="recit__tete">
              <p class="label label--accent">Chantier 01 · en {etapes.length} étapes</p>
              <h2 class="h1">Derrière un mur fini.</h2>
            </div>
            <ol class="recit__etapes">
              {etapes.map((e, i) => (
                <li class:list={[{ 'is-current': i === 0 }]}>
                  <span class="recit__n display" aria-hidden="true">{deux(i + 1)}</span>
                  <div>
                    <h3>{e.titre}</h3>
                    <p>{fr(e.texte)}</p>
                  </div>
                </li>
              ))}
            </ol>
            <div class="recit__jauge" aria-hidden="true"><span></span></div>
          </div>

          <div class="recit__dessin" aria-hidden="true">
            <div class="recit__toile"></div>
            <div class="recit__noms">
              {couches.map((c) => <span><i>{c.nom}</i></span>)}
            </div>
            <p class="label recit__note">Schéma de principe</p>
            <p class="label recit__fini">Mur doublé, prêt à peindre</p>
          </div>

          <div class="recit__photos">
            {etapes.map((e) => (
              <figure class="recit__photo">
                <Picture src={e.cliche.image} formats={['avif', 'webp']} widths={[540, 720, 1080]} sizes="(min-width: 60rem) 34vw, 100vw" alt={e.cliche.alt} loading="eager" />
              </figure>
            ))}
            <span class="recit__laser" aria-hidden="true"></span>
            <span class="recit__compteur label" aria-hidden="true">Photo <b>01</b> / {deux(etapes.length)}</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="index s-yellow section">
    <div class="wrap">
      <Cote left="Index" right={`${CHANTIERS.length} chantiers`} />
      <h2 class="h1 index__titre">Choisissez un chantier.</h2>
      <ol class="index__list">
        {index.map(({ c, apercu }, i) => (
          <li>
            <a href={`#${c.slug}`} data-apercu={apercu}>
              <span class="index__n label">{deux(i + 1)}</span>
              <span class="index__t display">{fr(c.titre)}</span>
              <span class="index__m label">{metier(c.services[0])?.label}{c.annee ? ` · ${c.annee}` : ''}</span>
              <span class="index__go" aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="apercu" aria-hidden="true"><img alt="" width="520" height="390" /></div>
  </section>

  {CHANTIERS.map((c, i) => (
    <section id={c.slug} class:list={['rc', i % 2 ? 's-dark' : 's-paper']}>
      <span class="rc__n display" aria-hidden="true">{deux(i + 1)}</span>
      <div class="wrap">
        <Cote left={`Chantier ${deux(i + 1)}`} right={lieu(c) || nombre(c)} />
        <header class="rc__head">
          <h2 class="h1">{fr(c.titre)}</h2>
          <div class="rc__text">
            <p>{fr(c.texte)}</p>
            <ul class="rc__services">
              {c.services.map((s) => metier(s)).filter((s) => s !== undefined).map((s) => (
                <li><a href={`/services/${s.slug}`}>{s.label} <span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </div>
        </header>
        <div class:list={['rc__corps', { 'rc__corps--seul': !MAQUETTES[c.slug] }]}>
          {MAQUETTES[c.slug] && (
            <div class="rc__maquette">
              <p class="label rc__sous">Comment c'est fait</p>
              <Maquette slug={c.slug} />
            </div>
          )}
          <div class="rc__photos">
            <p class="label rc__sous">Sur le chantier · {nombre(c)}</p>
            <Galerie cliches={c.cliches} etiquettes={etiquettes(c)} />
          </div>
        </div>
      </div>
    </section>
  ))}

  <Cta title="Un chantier du même genre chez vous ?" />
</Base>

<script>
  // La 3D et les animations se chargent quand le navigateur est libre : le premier affichage ne les attend pas.
  const start = () => import('../scripts/realisations.ts');
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
  else setTimeout(start, 600);
</script>

<style>
  /* En-tête */
  .rh { position: relative; overflow: clip; }
  .rh__grille { position: absolute; inset: 0; background-image: linear-gradient(var(--paper-06) 1px, transparent 1px), linear-gradient(90deg, var(--paper-06) 1px, transparent 1px); background-size: clamp(3rem, 8.33vw, 8rem) clamp(3rem, 8.33vw, 8rem); mask-image: linear-gradient(to bottom, var(--ink) 40%, transparent); }
  .rh__inner { position: relative; display: grid; gap: 2.5rem; padding-block: clamp(1.75rem, 1rem + 3vw, 4rem) clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .rh__texte { position: relative; z-index: 2; display: grid; gap: 1.1rem; justify-items: start; min-width: 0; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.2rem 0.55rem; }
  .crumbs li + li::before { content: '/'; margin-right: 0.55rem; color: var(--paper-40); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--yellow); }
  .rh__titre { font-size: clamp(2.9rem, 1rem + 8.4vw, 6.6rem); line-height: 0.88; letter-spacing: -0.02em; }
  .line { display: block; overflow: clip; overflow-clip-margin: 0.04em; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .line > span { display: block; }
  .accent { color: var(--yellow); }
  .rh__lede { font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3rem); line-height: 1.45; max-width: 54ch; }
  .rh .btn-row { margin-top: 0.5rem; }

  /* Quatre photos posées à des profondeurs différentes. */
  .rh__planche { position: relative; width: min(100%, 30rem); aspect-ratio: 1 / 0.92; margin-inline: auto; }
  .rh__photo { position: absolute; display: block; border: 2px solid var(--paper); background: var(--ink); box-shadow: 7px 7px 0 var(--yellow); overflow: clip; will-change: transform; }
  .rh__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .rh__photo--0 { right: 3%; top: 0; width: 47%; aspect-ratio: 3 / 4; z-index: 2; }
  .rh__photo--1 { left: 0; bottom: 6%; width: 60%; aspect-ratio: 4 / 3; z-index: 4; }
  .rh__photo--2 { right: 0; bottom: 0; width: 32%; aspect-ratio: 3 / 4; z-index: 3; }
  .rh__photo--3 { left: 9%; top: 5%; width: 33%; aspect-ratio: 1; z-index: 1; box-shadow: 5px 5px 0 var(--paper-40); }
  .rh__suite { position: relative; display: flex; align-items: center; gap: 0.7rem; padding-bottom: 1.5rem; color: var(--yellow); }
  .rh__fleche { display: inline-block; }

  @media (prefers-reduced-motion: no-preference) {
    .line > span { animation: rh-rise 1s var(--ease-out) both; animation-delay: calc(var(--i) * 90ms + 80ms); }
    .rh__lede, .rh .btn-row, .rh .label { animation: rh-fade 0.8s ease 0.5s both; }
    .rh__photo { animation: rh-pose 1.1s var(--ease-out) both; }
    .rh__photo--0 { animation-delay: 0.25s; }
    .rh__photo--1 { animation-delay: 0.4s; }
    .rh__photo--2 { animation-delay: 0.55s; }
    .rh__photo--3 { animation-delay: 0.15s; }
    .rh__fleche { animation: rh-tombe 1.6s var(--ease-inout) infinite; }
  }
  @keyframes rh-rise { from { transform: translateY(105%); } }
  @keyframes rh-fade { from { opacity: 0; transform: translateY(0.6rem); } }
  @keyframes rh-pose { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes rh-tombe { 50% { transform: translateY(0.35rem); } }

  @media (min-width: 60rem) {
    .rh__inner { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: clamp(1rem, 3vw, 4rem); min-height: calc(100svh - var(--header-h) - 4rem); }
    .rh__planche { width: 100%; }
  }

  /* Le chantier raconté. Par défaut (sans animation) : trois étapes, trois photos. */
  .recit { padding-block: var(--section); }
  .recit__grid { display: grid; gap: 2.5rem; }
  .recit__texte { display: grid; gap: 2rem; align-content: start; }
  .recit__tete { display: grid; gap: 1rem; }
  .recit__etapes { display: grid; gap: 1.75rem; }
  .recit__etapes li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.1rem; align-items: start; }
  .recit__n { padding: 0.1em 0.28em 0.04em; border: 2px solid var(--yellow); color: var(--yellow); font-size: var(--fs-xl); line-height: 1; }
  .recit__etapes h3 { font-size: var(--fs-xl); }
  .recit__etapes p { margin-top: 0.35rem; color: var(--muted); max-width: 34ch; }
  .recit__photos { display: grid; gap: 1.75rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .recit__photo { margin: 0 6px 0 0; border: 2px solid var(--paper); background: var(--ink); box-shadow: 6px 6px 0 var(--yellow); overflow: clip; }
  .recit__photo :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  .recit__dessin, .recit__jauge, .recit__laser, .recit__compteur { display: none; }

  /* Avec animation : la scène occupe l'écran et se déroule au défilement. */
  .recit.is-scene { padding-block: 0; }
  .is-scene .recit__pin { height: calc(100svh - var(--header-h) - 3.4rem); overflow: clip; }
  .is-scene .recit__grid { height: 100%; grid-template-rows: auto auto minmax(0, 1fr) auto auto; gap: 0.8rem; padding-block: 1rem; }
  .is-scene .recit__texte { display: contents; }
  .is-scene .recit__tete { order: 1; gap: 0.4rem; }
  .is-scene .recit__tete h2 { font-size: var(--fs-xl); }
  .is-scene .recit__photos { order: 2; position: relative; display: block; aspect-ratio: 16 / 10; margin-right: 6px; border: 2px solid var(--paper); background: var(--ink); box-shadow: 6px 6px 0 var(--yellow); }
  .is-scene .recit__photo { position: absolute; inset: 0; margin: 0; border: 0; box-shadow: none; }
  .is-scene .recit__photo :global(img) { height: 100%; aspect-ratio: auto; }
  .is-scene .recit__laser { display: block; position: absolute; top: -0.5rem; bottom: -0.5rem; left: 100%; width: 3px; margin-left: -1.5px; background: var(--yellow); box-shadow: 0 0 1.25rem 0.2rem var(--yellow); opacity: 0; }
  .is-scene .recit__compteur { display: block; position: absolute; left: 0; top: 0; padding: 0.35rem 0.6rem; background: var(--yellow); color: var(--anthracite); }
  .is-scene .recit__dessin { order: 3; display: block; position: relative; min-height: 0; }
  .is-scene .recit__toile { position: absolute; inset: 0; }
  .recit__toile :global(canvas) { display: block; width: 100%; height: 100%; }
  .recit__noms { position: absolute; inset: 0; pointer-events: none; transition: opacity 0.4s; }
  .recit__noms span { position: absolute; left: 0; top: 0; display: none; transition: opacity 0.2s; }
  .recit__noms i { position: relative; display: block; translate: -50% calc(-100% - 0.9rem); padding: 0.2rem 0.45rem; border: 1.5px solid var(--paper-40); background: var(--ink); color: var(--paper-70); font-family: var(--font-mono), monospace; font-style: normal; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; opacity: 0; transition: opacity 0.3s; }
  .recit__noms i::after { content: ''; position: absolute; left: 50%; top: 100%; width: 1.5px; height: 0.9rem; background: var(--paper-40); }
  .recit__noms span:global(.is-active) i::after { background: var(--yellow); }
  .recit__noms span:global(.is-active) i { opacity: 1; border-color: var(--yellow); background: var(--yellow); color: var(--anthracite); }
  .is-ferme .recit__noms { opacity: 0; }
  .recit__note, .recit__fini { position: absolute; left: 0; bottom: 0; }
  .recit__fini { left: auto; right: 0; color: var(--yellow); opacity: 0; transition: opacity 0.4s; }
  .is-ferme .recit__fini { opacity: 1; }
  .is-scene .recit__etapes { order: 4; display: block; position: relative; min-height: 6.75rem; }
  .is-scene .recit__etapes li { position: absolute; inset: 0; opacity: 0; translate: 0 0.6rem; transition: opacity 0.4s, translate 0.5s var(--ease-out); }
  .is-scene .recit__etapes li.is-current { opacity: 1; translate: 0 0; }
  .is-scene .recit__etapes h3 { font-size: var(--fs-l); }
  .is-scene .recit__etapes p { font-size: var(--fs-s); }
  .is-scene .recit__jauge { order: 5; display: block; height: 4px; background: var(--paper-14); }
  .recit__jauge span { display: block; height: 100%; background: var(--yellow); scale: 0 1; transform-origin: left; }

  @media (min-width: 60rem) {
    .recit__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .recit__photos { grid-column: 1 / -1; }
    .is-scene .recit__pin { height: calc(100svh - var(--header-h)); }
    .is-scene .recit__grid { grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.2fr) minmax(0, 1.05fr); grid-template-rows: minmax(0, 1fr); gap: clamp(1.5rem, 2.5vw, 3rem); align-items: center; padding-block: 1.5rem; }
    .is-scene .recit__texte { display: grid; gap: 1.75rem; order: 1; }
    .is-scene .recit__tete h2 { font-size: var(--fs-2xl); }
    .is-scene .recit__dessin { order: 2; align-self: stretch; }
    .is-scene .recit__photos { order: 3; grid-column: auto; aspect-ratio: 4 / 3; }
    .is-scene .recit__etapes { display: grid; gap: 1.1rem; min-height: 0; }
    .is-scene .recit__etapes li { position: static; opacity: 0.32; translate: none; transition: opacity 0.4s; }
    .is-scene .recit__etapes li.is-current { opacity: 1; }
    .recit__noms span { display: block; }
  }

  /* Index */
  .index { position: relative; }
  .index__titre { margin-block: 1.5rem clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .index__list { border-top: 2px solid var(--anthracite); }
  .index__list a { position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto; gap: 0.2rem 0.75rem; align-items: baseline; padding: 1.1rem 0.25rem; border-bottom: 1px solid var(--anthracite); text-decoration: none; isolation: isolate; transition: padding 0.35s var(--ease-out), color 0.2s; }
  .index__list a::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--anthracite); scale: 1 0; transform-origin: bottom; transition: scale 0.4s var(--ease-out); }
  .index__list a:hover, .index__list a:focus-visible { padding-left: 1.1rem; color: var(--yellow); }
  .index__list a:hover::before, .index__list a:focus-visible::before { scale: 1 1; }
  .index__list a:hover .label, .index__list a:focus-visible .label { color: var(--paper-70); }
  .index__t { font-size: var(--fs-xl); line-height: 1.02; }
  .index__m { grid-column: 2; }
  .index__go { grid-row: 1; grid-column: 3; font-size: var(--fs-xl); transition: translate 0.3s var(--ease-out); }
  .index__list a:hover .index__go { translate: 0 0.25em; }
  .apercu { position: fixed; left: 0; top: 0; z-index: 30; width: 19rem; margin: -7rem 0 0 1.75rem; border: 2px solid var(--paper); background: var(--ink); box-shadow: 7px 7px 0 var(--yellow); pointer-events: none; opacity: 0; scale: 0.6; transition: opacity 0.25s, scale 0.4s var(--ease-out); overflow: clip; }
  .apercu:global(.is-on) { opacity: 1; scale: 1; }
  .apercu img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 60rem) {
    .index__list a { grid-template-columns: 3.5rem minmax(0, 1fr) 15rem auto; padding-block: 1.4rem; }
    .index__t { font-size: clamp(2rem, 1.1rem + 2.1vw, 3.3rem); }
    .index__m { grid-column: 3; text-align: right; }
    .index__go { grid-column: 4; }
  }

  /* Les chantiers */
  .rc { position: relative; overflow: clip; padding-block: var(--section); }
  .rc > .wrap { position: relative; }
  /* Le numéro du chantier, en contour, qui glisse derrière le contenu. */
  .rc__n { position: absolute; right: var(--gutter); top: 1rem; font-size: clamp(9rem, 4rem + 26vw, 30rem); line-height: 0.8; color: transparent; -webkit-text-stroke: 2px var(--line); pointer-events: none; user-select: none; }
  .rc__head { display: grid; gap: 1.5rem; margin-block: 1.5rem clamp(2.5rem, 2rem + 2vw, 4rem); }
  .rc__head h2 { max-width: 20ch; }
  .rc__text { display: grid; gap: 1.1rem; align-content: start; max-width: 60ch; }
  .rc__services { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; font-weight: 700; }
  .rc__services a { display: inline-flex; gap: 0.5em; text-decoration-thickness: 3px; }
  .rc__services span { transition: translate 0.25s var(--ease-out); }
  .rc__services a:hover span { translate: 0.3em 0; }
  .rc__corps { display: grid; gap: 3rem; }
  .rc__sous { margin-bottom: 1rem; color: var(--accent); }
  @media (min-width: 60rem) {
    .rc__head { grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 4vw, 5rem); align-items: end; }
    .rc__corps { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 4vw, 4.5rem); align-items: start; }
