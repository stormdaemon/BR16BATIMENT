---
// Ferme de charpente traditionnelle : l'emblème du site, tracée comme une épure.
// Le tracé au chargement est en CSS seul, pour ne rien retarder.
interface Props { class?: string }
const { class: cls } = Astro.props;

const L = [70, 470];
const R = [930, 470];
const T = [500, 92];
const at = (a: number[], b: number[], t: number) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
const angle = (Math.atan2(T[1] - L[1], T[0] - L[0]) * 180) / Math.PI;

const purlins = [0.22, 0.48, 0.74].flatMap((t) => {
  const [lx, ly] = at(L, T, t);
  const [rx, ry] = at(R, T, t);
  return [
    { x: lx, y: ly - 15, rot: angle },
    { x: rx, y: ry - 15, rot: -angle },
  ];
});
const [sl, sr] = [at(L, T, 0.48), at(R, T, 0.48)];

const labels = [
  { text: 'Faîtage', x: 500, y: 40, anchor: 'middle', line: 'M500 48V68' },
  { text: 'Arbalétrier', x: 150, y: 250, anchor: 'start', line: 'M214 262L262 292' },
  { text: 'Panne', x: 806, y: 248, anchor: 'start', line: 'M800 256L748 276' },
  { text: 'Poinçon', x: 532, y: 440, anchor: 'start', line: 'M528 435H508' },
  { text: 'Contrefiche', x: 690, y: 402, anchor: 'start', line: 'M686 396L640 366' },
  { text: 'Entrait', x: 500, y: 532, anchor: 'middle', line: 'M500 514V492' },
];
---
<svg class:list={['truss', cls]} viewBox="0 0 1000 560" role="img" aria-labelledby="truss-t">
  <title id="truss-t">Ferme de charpente traditionnelle : entrait, arbalétriers, poinçon, contrefiches, pannes et faîtage</title>
  <g class="truss__guides">
    <path pathLength="1" d="M0 470H1000" />
    <path pathLength="1" d="M500 0V560" />
    <path pathLength="1" d="M0 92H1000" />
  </g>
  <g class="truss__wood">
    <path pathLength="1" style="--d:.1s" d={`M${L[0] - 30} ${L[1]}H${R[0] + 30}V${L[1] + 24}H${L[0] - 30}Z`} />
    <path pathLength="1" style="--d:.35s" d={`M${L[0]} ${L[1]}L${T[0]} ${T[1]}`} />
    <path pathLength="1" style="--d:.45s" d={`M${R[0]} ${R[1]}L${T[0]} ${T[1]}`} />
    <path pathLength="1" style="--d:.55s" d={`M${L[0] + 34} ${L[1]}L${T[0]} ${T[1] + 30}`} />
    <path pathLength="1" style="--d:.65s" d={`M${R[0] - 34} ${R[1]}L${T[0]} ${T[1] + 30}`} />
    <path pathLength="1" style="--d:.8s" d={`M${T[0] - 13} ${T[1] + 14}V${L[1]}M${T[0] + 13} ${T[1] + 14}V${L[1]}`} />
    <path pathLength="1" style="--d:1s" d={`M${T[0] - 13} ${L[1] - 56}L${sl[0] + 8} ${sl[1] + 12}M${T[0] - 13} ${L[1] - 90}L${sl[0] + 26} ${sl[1] + 6}`} />
    <path pathLength="1" style="--d:1.1s" d={`M${T[0] + 13} ${L[1] - 56}L${sr[0] - 8} ${sr[1] + 12}M${T[0] + 13} ${L[1] - 90}L${sr[0] - 26} ${sr[1] + 6}`} />
    <rect pathLength="1" style="--d:1.25s" x={T[0] - 15} y={T[1] - 28} width="30" height="30" />
    {purlins.map((p, i) => (
      <rect pathLength="1" style={`--d:${1.3 + i * 0.05}s`} x={p.x - 14} y={p.y - 14} width="28" height="28" transform={`rotate(${p.rot} ${p.x} ${p.y})`} />
    ))}
  </g>
  <g class="truss__labels" aria-hidden="true">
    {labels.map((l, i) => (
      <g style={`--d:${1.6 + i * 0.07}s`}>
        <path d={l.line} />
        <text x={l.x} y={l.y} text-anchor={l.anchor}>{l.text}</text>
      </g>
    ))}
  </g>
</svg>

<style>
  .truss { width: 100%; height: auto; overflow: visible; }
  .truss path, .truss rect { fill: none; }
  .truss__guides path { stroke: var(--paper-14); stroke-width: 1; stroke-dasharray: 4 7; }
  .truss__wood > * { stroke: var(--yellow); stroke-width: 2.5; stroke-linejoin: round; stroke-dasharray: 1; }
  .truss__labels path { stroke: var(--paper-40); stroke-width: 1; }
  .truss__labels text { font-family: var(--font-mono), monospace; font-size: 17px; letter-spacing: 0.05em; fill: var(--paper-70); text-transform: uppercase; }

  @media (prefers-reduced-motion: no-preference) {
    .truss__wood > * { stroke-dashoffset: 1; animation: truss-draw 1.1s var(--ease-inout) var(--d, 0s) forwards; }
    .truss__labels g { opacity: 0; animation: truss-fade 0.6s ease var(--d, 0s) forwards; }
  }
  @keyframes truss-draw { to { stroke-dashoffset: 0; } }
  @keyframes truss-fade { to { opacity: 1; } }
</style>
