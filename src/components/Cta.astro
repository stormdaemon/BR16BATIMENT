---
import { SITE } from '../data/site';
interface Props { title?: string; text?: string; service?: string }
const { title = 'Parlons de votre projet.', text = `Devis gratuit. Réponse ${SITE.responseDelay}.`, service } = Astro.props;
const href = service ? `/contact?projet=${encodeURIComponent(service)}` : '/contact';
---
<section class="cta s-yellow">
  <div class="wrap cta__inner">
    <p class="label">{SITE.name} · {SITE.address.city}</p>
    <h2 class="cta__title">{title}</h2>
    <a class="cta__phone display" href={SITE.phoneHref}>{SITE.phone}</a>
    <div class="cta__foot">
      <p>{text}</p>
      <a class="btn btn--dark" href={href}>Demander un devis <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--section); overflow: hidden; }
  .cta__inner { display: grid; gap: clamp(1rem, 0.6rem + 1.5vw, 2rem); }
  .cta__title { font-size: var(--fs-xl); }
  .cta__phone { display: block; font-size: clamp(2.9rem, 0.5rem + 12.8vw, 13rem); line-height: 0.95; text-decoration: none; white-space: nowrap; font-variant-numeric: tabular-nums; transition: color 0.2s; }
  .cta__phone:hover { color: var(--ink); text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.08em; text-decoration-color: currentColor; }
  .cta__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; font-size: var(--fs-l); }
</style>
