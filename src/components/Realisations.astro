---
// Photos de chantiers et avis réels. Sans donnée, le composant n'affiche rien.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { AVIS, REALISATIONS } from '../data/preuves';
import { fr } from '../lib/typo';

interface Props { service?: string }
const { service } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/realisations/*.{jpg,jpeg,png,webp}', { eager: true });
const photoOf = (name: string) => files[`../assets/realisations/${name}`]?.default;

const realisations = REALISATIONS.filter((r) => (!service || r.service === service) && photoOf(r.photo));
const avis = AVIS.filter((a) => !service || !a.service || a.service === service);
---
{(realisations.length > 0 || avis.length > 0) && (
  <div class="real">
    {realisations.length > 0 && (
      <>
        <h3>Réalisations</h3>
        <ul class="real__photos">
          {realisations.map((r) => (
            <li>
              <figure>
                <Picture src={photoOf(r.photo)!} formats={['avif', 'webp']} widths={[480, 960]} sizes="(min-width: 48rem) 33vw, 100vw" alt={r.alt} loading="lazy" />
                <figcaption>{fr(r.titre)}, {r.commune}, {r.annee}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </>
    )}
    {avis.length > 0 && (
      <>
        <h3>Avis de clients</h3>
        <ul class="real__avis">
          {avis.map((a) => (
            <li>
              <blockquote>{fr(a.texte)}</blockquote>
              <p class="label">{a.auteur}{a.commune ? `, ${a.commune}` : ''} · {a.source}, {a.date}</p>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
)}

<style>
  .real { display: grid; gap: 1rem; margin-top: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .real__photos, .real__avis { display: grid; gap: 1.5rem; }
  figure { margin: 0; display: grid; gap: 0.5rem; }
  figure :global(img) { width: 100%; height: auto; }
  figcaption { font-size: var(--fs-s); }
  blockquote { margin: 0 0 0.5rem; font-size: var(--fs-l); line-height: 1.3; }
  @media (min-width: 48rem) { .real__photos, .real__avis { grid-template-columns: repeat(3, 1fr); } }
</style>
