---
// Photos de chantiers et avis réels, sous les garanties. Sans donnée, le composant n'affiche rien.
import Galerie from './Galerie.astro';
import { AVIS } from '../data/preuves';
import { selection } from '../lib/realisations';
import { fr } from '../lib/typo';

interface Props { service?: string }
const { service } = Astro.props;

const cliches = selection(service);
const avis = AVIS.filter((a) => !service || !a.service || a.service === service);
---
{(cliches.length > 0 || avis.length > 0) && (
  <div class="real">
    {cliches.length > 0 && (
      <>
        <div class="real__head">
          <h3>Sur mes chantiers</h3>
          <a class="real__all" href="/realisations">Toutes les réalisations <span aria-hidden="true">→</span></a>
        </div>
        <Galerie cliches={cliches} />
      </>
    )}
    {avis.length > 0 && (
      <>
        <h3>Avis de clients</h3>
        <ul class="real__avis">
          {avis.map((a) => (
            <li>
              <blockquote>{fr(a.texte)}</blockquote>
              <p class="label">{a.auteur}{a.commune ? `, ${a.commune}` : ''} · {a.source}, {a.date}</p>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
)}

<style>
  .real { display: grid; gap: 1.5rem; margin-top: clamp(2.5rem, 2rem + 2vw, 4rem); padding-top: clamp(2rem, 1.5rem + 2vw, 3rem); border-top: 1px solid var(--line); }
  .real__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; }
  .real__head h3 { font-size: var(--fs-xl); }
  .real__all { display: inline-flex; gap: 0.6em; font-weight: 700; text-decoration-thickness: 3px; }
  .real__all span { transition: translate 0.25s var(--ease-out); }
  .real__all:hover span { translate: 0.3em 0; }
  .real__avis { display: grid; gap: 1.5rem; }
  blockquote { margin: 0 0 0.5rem; font-size: var(--fs-l); line-height: 1.3; }
  @media (min-width: 48rem) { .real__avis { grid-template-columns: repeat(3, 1fr); } }
</style>
