---
// Une rangée de photos à la même hauteur, chacune dans son format d'origine : aucune n'est rognée.
import Cliche from './Cliche.astro';
import type { Cliche as Photo } from '../lib/realisations';

interface Props { cliches: Photo[]; etiquettes?: (string | undefined)[] }
const { cliches, etiquettes = [] } = Astro.props;
---
<ul class="galerie">
  {cliches.map((c, i) => (
    <li style={`--r:${(c.image.width / c.image.height).toFixed(3)};--d:${(i % 3) * 0.07}s`} data-reveal>
      <Cliche cliche={c} etiquette={etiquettes[i]} sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 50vw, 100vw" />
    </li>
  ))}
</ul>

<style>
  /* Largeur proportionnelle au format : les photos d'une même rangée ont la même hauteur. */
  .galerie { display: flex; flex-wrap: wrap; gap: 2rem 1.5rem; }
  .galerie li { flex: var(--r) 1 100%; min-width: 0; }
  @media (min-width: 40rem) {
    .galerie li { flex-basis: calc(var(--r) * 14rem); max-width: calc(var(--r) * 26rem); }
  }

  /* Apparition : un rideau jaune se retire et la photo se cale dans son cadre. */
  :global(.js) .galerie li[data-reveal] { opacity: 1; translate: none; }
  :global(.js) .galerie li :global(.cliche__cadre)::after { content: ''; position: absolute; inset: 0; z-index: 2; background: var(--yellow); transform-origin: 100% 50%; transition: scale 0.95s var(--ease-inout) var(--d, 0s); }
  :global(.js) .galerie li:global(.is-in) :global(.cliche__cadre)::after { scale: 0 1; }
  :global(.js) .galerie li :global(figcaption) { opacity: 0; translate: 0 0.5rem; transition: opacity 0.6s calc(var(--d, 0s) + 0.55s), translate 0.6s var(--ease-out) calc(var(--d, 0s) + 0.55s); }
  :global(.js) .galerie li:global(.is-in) :global(figcaption) { opacity: 1; translate: 0 0; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .galerie li:global(.is-in) :global(.cliche__cadre img) { animation: galerie-cale 1.5s var(--ease-out) var(--d, 0s) backwards; }
  }
  @keyframes galerie-cale { from { scale: 1.28; } }
</style>
